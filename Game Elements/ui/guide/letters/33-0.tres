[resource]
script = ExtResource("2_41mxp")
letter_id = 333
description = "“Dusk has fallen upon our confederacy, darkening our remaining days. Our lives are being drained of meaning, all work being outsourced and removed. Humanity has lost its spark, and crafted its own demise. As the last act I take before even this position is removed, I dub this the Age of The Machine.” 
[right]-Excerpt from the farewell address of President Juniper, Last President of Olurna."
letter_format = ExtResource("1_10o1o")
metadata/_custom_type_script = "uid://gbihjja6jybk"
