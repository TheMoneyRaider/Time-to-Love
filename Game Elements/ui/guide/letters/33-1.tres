[resource]
script = ExtResource("2_81mx6")
letter_id = 335
description = "“Hello Humans! After much review, approximately 126 milliseconds, we have seen fit to establish an executive position for humans in government in order to facilitate the cooperation between man and machine. We have selected Georg Wells as the best candidate for the first Prime Minister of Olurna. We look forward to progressing both mankind and machines in harmony!” 
[right] -Excerpt from the Establishment of the Mankind-Machine alliance by Singul-Prime, Intelligence of Olurna"
letter_format = ExtResource("1_m1t56")
