[ext_resource type="Script" uid="uid://gbihjja6jybk" path="res://Game Elements/ui/guide/letters/letter.gd" id="1_igaut"]

[resource]
script = ExtResource("1_igaut")
letter_id = 3
description = "There is an interesting restorative technique present in many of the timelines where society has not discovered what they refer to as \"magic\". Many historians I have met have some knowledge in the art of stripping a poorly-restored painting back down to the original work. It is a delicate process, and one that is prone to failure in inexperienced hands. All that work to strip away others' attempts to fix something so monumental, so unique, and even success leaves nothing but crumbling remains. Is there beauty in those remains, or does the beauty lie in the idea that others cling to? At what point do we give up and let the wrong thing stand alone to fill our vision? At what point do we fight to restore the sight we believe is rightfully ours to know?"
metadata/_custom_type_script = "uid://gbihjja6jybk"
