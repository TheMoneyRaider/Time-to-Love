[resource]
script = ExtResource("2_rblq3")
letter_id = 240
description = "By decree of the Mancer of Mancers, for the crimes of theft and impersonation of another mancer, the false mancer known only as “Purple” is hitherto banished from the mancer’s guild and her status as mancer is revoked. May our mancations continue unabated for the eons to come. 
[right]
-Veera, the Loquimancer, Proclamation of the Mancer’s Guild
"
letter_format = ExtResource("1_24x7f")
metadata/_custom_type_script = "uid://gbihjja6jybk"
