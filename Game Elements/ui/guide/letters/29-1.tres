script = ExtResource("2_tfxpc")
letter_id = 275
description = "“Dawn has come to aid our kingdom, lighting a new age of prosperity! New frontiers are open before us, and opportunities are behind every corner! In honor of the new beginnings that have been brought to us, I hereby dub this the Age of Magic!” 
[right]-Excerpt from the Coronation of King Ailinus, First King of Plurna"
