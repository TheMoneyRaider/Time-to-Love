[resource]
script = ExtResource("1_d38s3")
letter_id = 2
description = "[color=#574d3e]Purple Room: Exhibit 4[br][br]
This rubbing, taken from carvings on a boulder discovered in the archeological remains of a 1388 French Battlefield, appears to demonstrate a personal grudge between the two enemy commanders. The boulder was likely launched by a trebuche. A reconstruction of a period accurate trebuche can be found in the orange hall."
letter_format = ExtResource("1_gf2qt")
