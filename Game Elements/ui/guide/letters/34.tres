[resource]
script = ExtResource("2_kri0o")
letter_id = 330
description = "My most cherished Orange,

As always, my dear, I do appreciate your enthusiasm. While your concern for the grove is most endearing, and does make me quite overjoyed, I would caution against this. I too have been to Olurna and it is not a place I care to think about again. In the hubris of their “enlightenment” they have decided to reduce the natural world to “greenhouse cities.” Perhaps this is the natural form of evolution but it is not the form of this grove. Besides, I worry for your safety in the acquisition. I look forward to joining you for tea, shall we say, Hampton Court, 1899?"
letter_format = ExtResource("1_n7mqm")
metadata/_custom_type_script = "uid://gbihjja6jybk"
